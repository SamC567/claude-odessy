# Example environment overrides for config/default.yaml.
# Copy to .env (untracked) and adjust. Never commit real values here;
# this project does not require any secret/API key for Milestone A.
#
# Format: ODYSSEUS_<SECTION>__<FIELD>=value (matches odysseus/config.py)

# Switch to a local Ollama server instead of the echo fallback:
# ODYSSEUS_MODEL__PROVIDER=ollama
# ODYSSEUS_MODEL__BASE_URL=http://localhost:11434
# ODYSSEUS_MODEL__MODEL_NAME=llama3

# Point memory at a different database file:
# ODYSSEUS_MEMORY__DB_PATH=data/odysseus_memory.sqlite3

# Let more (or fewer) approved memories into one model prompt (default 3, 0 = none):
# ODYSSEUS_MEMORY__CONTEXT_LIMIT=3

# Raise log verbosity:
# ODYSSEUS_LOG_LEVEL=DEBUG

# Write the audit trail somewhere else (default: data/audit.log):
# ODYSSEUS_AUDIT_LOG_PATH=data/audit.log
